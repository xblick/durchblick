# find_package(durchblick) for C++ components: durchblick::core (rings) and, when built with the camera API,
# durchblick::durchblick (CameraPublisher, ImageSubscriber on zenoh-cpp), and with DURCHBLICK_POINTS durchblick::points
# (the point cloud node; find_package(durchblick COMPONENTS points) requires it).
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@DURCHBLICK_WITH_CAMERA@)
  find_dependency(zenohc 1.10)
  find_dependency(zenohcxx 1.10)
  find_dependency(JPEG)
  find_dependency(PNG)
endif()
set(durchblick_points_FOUND @DURCHBLICK_WITH_POINTS@)
if(@DURCHBLICK_WITH_POINTS@)
  # the CUDA toolkit durchblick was built with, unless the consumer names one
  if(NOT DEFINED CUDAToolkit_ROOT AND NOT DEFINED ENV{CUDAToolkit_ROOT})
    set(CUDAToolkit_ROOT "@DURCHBLICK_CUDA_TOOLKIT_ROOT@")
  endif()
  find_dependency(CUDAToolkit)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/durchblickTargets.cmake")
check_required_components(durchblick)
