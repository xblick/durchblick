# find_package(xblick) for C++ components: xblick::core (rings) and, when built with the camera API,
# xblick::xblick (CameraPublisher, ImageSubscriber on zenoh-cpp), and with XBLICK_POINTS xblick::points
# (the point cloud node; find_package(xblick COMPONENTS points) requires it).
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@XBLICK_WITH_CAMERA@)
  find_dependency(zenohc 1.10)
  find_dependency(zenohcxx 1.10)
  find_dependency(JPEG)
  find_dependency(PNG)
endif()
set(xblick_points_FOUND @XBLICK_WITH_POINTS@)
if(@XBLICK_WITH_POINTS@)
  # the CUDA toolkit Durchblick was built with, unless the consumer names one
  if(NOT DEFINED CUDAToolkit_ROOT AND NOT DEFINED ENV{CUDAToolkit_ROOT})
    set(CUDAToolkit_ROOT "@XBLICK_CUDA_TOOLKIT_ROOT@")
  endif()
  find_dependency(CUDAToolkit)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/xblickTargets.cmake")
check_required_components(xblick)
